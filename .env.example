# 이 파일을 복사해 .env를 만들고 값을 메모장으로 직접 넣습니다. (.env는 GitHub에 올리지 않음)
# 배포할 때는 Vercel → Settings → Environment Variables에 같은 이름으로 넣습니다.
SUPABASE_URL=https://여기에_프로젝트_ID.supabase.co
SUPABASE_SECRET_KEY=여기에_Secret_key_붙여넣기

# API를 직접 부르는 주제라면 사용 (이 사례는 CSV → Supabase라 쓰지 않음)
# DATA_GO_KR_KEY=
# AI 기능을 붙일 때 사용 (4회차)
# OPENROUTER_API_KEY=
